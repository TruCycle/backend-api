NODE_ENV=development
PORT=3000

# Toggle database integration (TypeORM)
# Set to true when you have a Postgres instance available (local or hosted)
ENABLE_DB=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=trucycle
DB_SSL=false
DB_LOGGING=false

# Automatic schema sync is disabled in code; use a separately approved migration release.
TYPEORM_SYNC=false

# CORS
CORS_ORIGINS=*

# Auth (JWT)
# Required explicit signing key, at least32bytes; no development fallback.
# Generate and store separately. Never commit an actual key here.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=90d
# Concurrent/lost-response refresh grace; bounded1to60seconds, no sliding sessions.
AUTH_REFRESH_RETRY_GRACE_SECONDS=30

# Google sign-in — OAuth 2.0 Web client ID from Google Cloud console.
# Must be the SAME client ID the frontend uses (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Browser-facing activation/item email links. Use the isolated frontend origin in staging.
FRONTEND_BASE_URL=http://localhost:5173
# Legacy app URL used by remaining integrations; not a substitute for FRONTEND_BASE_URL.
APP_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:3000

# Email (Brevo preferred; Resend only when Brevo is unconfigured, no automatic delivery retry)
# Generate an API key at https://www.brevo.com or https://resend.com
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM="TruCycle <no-reply@trucycle.local>"

# QR code hosting base URL (used as a fallback if per-item URL not set)
# For Cloudinary, this would look like:
#   https://res.cloudinary.com/<cloud-name>/image/upload/qrs
ITEM_QR_BASE_URL=

# Cloudinary (for QR PNG storage)
# Create a Cloudinary account and set these values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder to store QR images in your Cloudinary account
CLOUDINARY_QR_FOLDER=qrs
# Optional: folder to store chat images in your Cloudinary account
CLOUDINARY_MESSAGE_FOLDER=messages

# Climatiq API for CO2 estimation
# Get a key at https://www.climatiq.io/
CLIMATIQ_API_KEY=
# Factor ID to use for weight-based estimation (set appropriately for your items)
# Example: electricity-energy_source_grid_mix... (see Climatiq catalog)
CLIMATIQ_EMISSION_FACTOR_ID=
CLIMATIQ_API_URL=https://api.climatiq.io/data/v1/estimate

# Environmental goals
# Optional override for the default 50kg monthly savings target shown in impact metrics
MONTHLY_CO2_SAVINGS_GOAL_KG=50

# Rewards (wallet & ledger)
# Currency code for points; stored as 3 chars
REWARDS_CURRENCY=PTS
# Amounts credited on claim completion
# To collector (exchange/donate flows)
REWARD_CLAIM_COLLECTOR=10
# To donor (exchange/donate flows)
REWARD_CLAIM_DONOR=5

# Nearby item email alerts
# Radius (km) used to email users near a drop-off location
NEARBY_ITEM_ALERT_RADIUS_KM=20
# Safety cap for recipients per item to avoid spamming
NEARBY_ITEM_ALERT_MAX_RECIPIENTS=200

# Optional shared per-minute authentication budgets. Set identical reviewed values
# on all API replicas after applying migration 0030 and verifying DB permissions.
# JSON keys: register, login, google, resend, reset_request, reset_attempt.
# Optional refresh key requires migration 0034 before enabling on any replica.
AUTH_RATE_LIMITS=

# Optional shared per-email, per-minute reset budgets. JSON keys: reset_request,
# reset_attempt. Requires AUTH_RATE_LIMITS and DB_LOGGING=false. Apply migration
# 0031 and verify the API DB role and counter cleanup before enabling.
AUTH_RESET_EMAIL_LIMITS=
# Dedicated random 32-byte hexadecimal HMAC key, identical on all API replicas.
AUTH_RESET_EMAIL_LIMIT_KEY=

# Opt in after migration 0035 and outbox runtime permissions are verified.
# Keep the same dedicated random 32-byte hexadecimal key on every API replica.
# Requires DB_LOGGING=false. Drain pending deliveries before rotating the key.
AUTH_EMAIL_OUTBOX_ENABLED=false
AUTH_EMAIL_OUTBOX_KEY=

# Optional per-process socket budgets. The connection and auth concurrency limits
# are shared by messaging and notifications. Packet limits apply per socket.
# Per-minute limits refill continuously and allow a burst up to the configured value.
SOCKET_CONNECTIONS_PER_MINUTE=
SOCKET_MAX_CONCURRENT_AUTH=
SOCKET_PACKETS_PER_MINUTE=

# Optional server-side Vision Worker HTTPS URL and dedicated 32-byte lowercase hex secret.
# Set the same secret on the matching Worker. Leave both blank to disable inference.
VISION_WORKER_URL=
VISION_WORKER_SECRET=
# Per API process. The rate refills continuously and permits a burst up to its value.
VISION_REQUESTS_PER_MINUTE=30
VISION_REQUESTS_PER_ACCOUNT_PER_MINUTE=6
VISION_MAX_CONCURRENT_REQUESTS=2

# Enable on one API replica after the isolated found-item lifecycle rehearsal.
FOUND_ITEM_LIFECYCLE_SWEEP_ENABLED=false

# Optional full Git commit SHA override supplied by the release pipeline.
# Railway uses RAILWAY_GIT_COMMIT_SHA automatically when this is unset.
APP_RELEASE_SHA=
